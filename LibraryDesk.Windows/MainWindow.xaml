<Window x:Class="LibraryDesk.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="میزکار هوشمند کتابخانه" Height="900" Width="1500" MinHeight="720" MinWidth="1100" WindowStartupLocation="CenterScreen" Background="#071426" FlowDirection="RightToLeft" KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#143653"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,4"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Padding" Value="15,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1E557B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="BrowserButton" TargetType="Button"><Setter Property="Background" Value="#EEF3F8"/><Setter Property="Foreground" Value="#17324D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="18"/><Setter Property="Width" Value="42"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0D2038" CornerRadius="22" Padding="18">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <Border Background="#143653" CornerRadius="15" Padding="15" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="میزکار هوشمند کتابخانه" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="دسترسی سریع • مرورگر یکپارچه" Foreground="#9CC7E7" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#0F766E"><TextBlock Text="کتاب" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
     <TextBlock Text="دسترسی‌های سریع" Foreground="#7EA8C7" FontSize="11" Margin="6,2,6,5"/>
     <Button Content="⌂   صفحه اصلی" Tag="home" Click="Shortcut_Click" Style="{StaticResource NavButton}"/>
     <Button Content="👤   ثبت عضو جدید" Tag="member" Click="Shortcut_Click" Style="{StaticResource NavButton}"/>
     <Button Content="▣   وضعیت مدارک" Tag="documents" Click="Shortcut_Click" Style="{StaticResource NavButton}"/>
     <Button Content="↗   ثبت امانت" Tag="loan" Click="Shortcut_Click" Style="{StaticResource NavButton}"/>
     <Button Content="↙   بازگشت کتاب" Tag="return" Click="Shortcut_Click" Style="{StaticResource NavButton}"/>
     <Button Content="📚   ثبت کتاب جدید" Tag="book" Click="Shortcut_Click" Style="{StaticResource NavButton}"/>
     <Button Content="★   برنامه‌های فرهنگی" Tag="culture" Click="Shortcut_Click" Style="{StaticResource NavButton}"/>
     <Button Content="⚙   مدیریت میانبرها" Click="Settings_Click" Style="{StaticResource NavButton}" Background="#0F766E"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Border Background="#102C47" CornerRadius="14" Padding="13" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="PersianDateText" Foreground="#A7F3D0" FontSize="14" HorizontalAlignment="Center"/><TextBlock x:Name="ClockText" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="تقویم شمسی • ساعت ۲۴ ساعته" Foreground="#759BB8" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
     <TextBlock Text="LibraryDesk V3.1" Foreground="#6FA5C9" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Column="2" Background="#F4F7FB" CornerRadius="22" ClipToBounds="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DDE5EE" BorderThickness="0,0,0,1" Padding="10">
     <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Button Content="←" ToolTip="عقب" Style="{StaticResource BrowserButton}" Click="Back_Click"/><Button Content="→" ToolTip="جلو" Style="{StaticResource BrowserButton}" Click="Forward_Click"/><Button Content="⟳" ToolTip="بارگذاری مجدد (F5)" Style="{StaticResource BrowserButton}" Click="Refresh_Click"/><Button Content="⌂" ToolTip="خانه" Style="{StaticResource BrowserButton}" Click="Home_Click"/></StackPanel>
      <Border Grid.Column="1" Background="#F2F5F9" CornerRadius="10" Margin="10,2"><Grid><TextBox x:Name="AddressBox" Background="Transparent" BorderThickness="0" Margin="12,0" VerticalContentAlignment="Center" FontSize="13" KeyDown="AddressBox_KeyDown" FlowDirection="LeftToRight"/><TextBlock Text="Ctrl+L" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/></Grid></Border>
      <Button Grid.Column="2" Content="باز کردن" Background="#0F766E" Foreground="White" BorderThickness="0" Padding="20,0" Margin="2" Click="Go_Click"/>
     </Grid>
    </Border>
    <wv2:WebView2 x:Name="Browser" Grid.Row="1" NavigationStarting="Browser_NavigationStarting" NavigationCompleted="Browser_NavigationCompleted"/>
    <Border Grid.Row="2" Background="#E7EEF5" Padding="12,0"><Grid><TextBlock x:Name="StatusText" Text="آماده" Foreground="#334155" VerticalAlignment="Center" FontSize="11"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="RightToLeft"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#10B981" Margin="5,0"/><TextBlock x:Name="ConnectionText" Text="آماده" Foreground="#0F766E" VerticalAlignment="Center" FontSize="11"/></StackPanel></Grid></Border>
   </Grid>
  </Border>
 </Grid>
</Window>