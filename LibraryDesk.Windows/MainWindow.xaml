<Window x:Class="LibraryDesk.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="میزکار هوشمند کتابخانه" Height="850" Width="1450" WindowStartupLocation="CenterScreen" Background="#071426" FlowDirection="RightToLeft">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#0D2038" CornerRadius="20" Padding="16">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="میزکار هوشمند کتابخانه" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,4,0,4"/>
     <TextBlock Text="نسخه آزمایشی V1" Foreground="#7DD3FC" FontSize="12" Margin="0,0,0,18"/>
     <Button Content="🏠  صفحه اصلی" Tag="https://www.iranpl.ir/" Click="Shortcut_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="48" Margin="0,4"/>
     <Button Content="👤  ثبت عضو جدید" Tag="https://www.iranpl.ir/" Click="Shortcut_Click" Height="48" Margin="0,4"/>
     <Button Content="📄  وضعیت مدارک" Tag="https://www.iranpl.ir/" Click="Shortcut_Click" Height="48" Margin="0,4"/>
     <Button Content="📤  ثبت امانت" Tag="https://www.iranpl.ir/" Click="Shortcut_Click" Height="48" Margin="0,4"/>
     <Button Content="📥  بازگشت کتاب" Tag="https://www.iranpl.ir/" Click="Shortcut_Click" Height="48" Margin="0,4"/>
     <Button Content="📚  ثبت کتاب جدید" Tag="https://www.iranpl.ir/" Click="Shortcut_Click" Height="48" Margin="0,4"/>
     <Button Content="🎭  برنامه‌های فرهنگی" Tag="https://www.iranpl.ir/" Click="Shortcut_Click" Height="48" Margin="0,4"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Separator Margin="0,12"/>
     <TextBlock x:Name="ClockText" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="اتصال امن • مرورگر داخلی WebView2" Foreground="#5EEAD4" FontSize="11" HorizontalAlignment="Center" Margin="0,8"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Column="2" Background="#F4F7FB" CornerRadius="20" ClipToBounds="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#DDE5EE" BorderThickness="0,0,0,1" Padding="12">
     <Grid FlowDirection="LeftToRight">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
       <Button Content="←" Width="42" Margin="2" Click="Back_Click"/><Button Content="→" Width="42" Margin="2" Click="Forward_Click"/><Button Content="⟳" Width="42" Margin="2" Click="Refresh_Click"/><Button Content="⌂" Width="42" Margin="2" Click="Home_Click"/>
      </StackPanel>
      <TextBox x:Name="AddressBox" Grid.Column="1" Margin="12,3" VerticalContentAlignment="Center" FontSize="14" KeyDown="AddressBox_KeyDown"/>
      <Button Grid.Column="2" Content="باز کردن" Padding="18,0" Margin="2" Click="Go_Click"/>
     </Grid>
    </Border>
    <wv2:WebView2 x:Name="Browser" Grid.Row="1" Source="https://www.iranpl.ir/" NavigationStarting="Browser_NavigationStarting" NavigationCompleted="Browser_NavigationCompleted"/>
    <Border Grid.Row="2" Background="#EAF0F6" Padding="10,0"><TextBlock x:Name="StatusText" Text="آماده" Foreground="#334155" VerticalAlignment="Center" FontSize="11"/></Border>
   </Grid>
  </Border>
 </Grid>
</Window>
